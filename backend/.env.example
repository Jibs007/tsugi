PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://tsugi:tsugi@localhost:5432/tsugi

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production_please
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Frontend
CLIENT_URL=http://localhost:5174

# Email (optional — welcome emails are logged to the console when SMTP_HOST is unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# MAIL_FROM="Tsugi <no-reply@yourdomain.com>"
